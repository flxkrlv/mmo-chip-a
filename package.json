{
  "name": "mmo-chip",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "frontend",
    "backend"
  ],
  "scripts": {
    "sidecar": "node scripts/run_sidecar.js",
    "dev": "concurrently -n be,fe,sc \"npm run dev -w backend\" \"npm run dev -w frontend\" \"npm run sidecar\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "npm run test -w backend && npm run test -w frontend"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@panzoom/panzoom": "^4.5.1",
    "adm-zip": "^0.5.17",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "elkjs": "^0.11.1",
    "jsonwebtoken": "^9.0.3",
    "present": "^1.0.0",
    "scripts": "^0.1.0"
  },
  "allowScripts": {
    "esbuild@0.27.4": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true
  }
}
