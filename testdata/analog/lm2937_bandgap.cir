* -- Testbench --
VDD VCC 0 DC 5
RLOAD ref 0 10k
X1 OUT VCC GND ref ref_1 net230 net345234 LM2937

* -- Analysis --
.op
.print op v(ref) v(ref_1) v(out) v(vcc)
.end
