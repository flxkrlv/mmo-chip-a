{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mmo-chip": {
      "type": "remote",
      "url": "http://127.0.0.1:3001/mcp",
      "enabled": true,
      "timeout": 20000,
      "headers": {
        "Authorization": "Bearer {env:MMOCHIP_TOKEN}"
      }
    },
    "mmo-chip-desktop": {
      "type": "remote",
      "url": "http://127.0.0.1:3101/mcp",
      "enabled": false,
      "timeout": 20000,
      "headers": {
        "Authorization": "Bearer {env:MMOCHIP_TOKEN}"
      }
    }
  }
}
